# =============================================================================
# Go Aventura Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit the actual .env.local file to version control

# =============================================================================
# =============================================================================


# =============================================================================
# reCAPTCHA Configuration
# =============================================================================
# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_V3_SECRET_KEY=your-recaptcha-secret-key

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email recipients
CONTACT_EMAIL_RECIPIENT=info@goaventura.com.ar
ADMIN_EMAIL_RECIPIENT=admin@goaventura.com.ar
SUPPORT_EMAIL_RECIPIENT=support@goaventura.com.ar

# =============================================================================
# Admin User Management Configuration
# =============================================================================
# Admin User Management Settings
ADMIN_ALLOWED_DOMAINS=goaventura.com.ar,example.com
ADMIN_DEFAULT_ROLE=admin
ADMIN_ENABLE_MFA=false
ADMIN_SESSION_TIMEOUT=3600

# Admin Security Settings
ADMIN_ENABLE_AUDIT_LOG=true
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=900

# Admin Email Notifications
ADMIN_NOTIFY_ON_USER_CREATE=true
ADMIN_NOTIFY_ON_USER_DELETE=true
ADMIN_NOTIFY_LOGIN_FAILURE=true

# =============================================================================
# Security Configuration
# =============================================================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Session Configuration
NEXTAUTH_URL=http://localhost:9002
NEXTAUTH_SECRET=your-nextauth-secret-key

# CORS Configuration
ALLOWED_ORIGINS=https://goaventura.com.ar,https://www.goaventura.com.ar,http://localhost:9002

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# API Rate Limiting
API_WINDOW_MS=900000
API_RATE_LIMIT=100
CONTACT_FORM_RATE_LIMIT=5
LOGIN_ATTEMPT_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=3

# =============================================================================
# File Upload Configuration
# =============================================================================
# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_IMAGE_SIZE=2097152
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Storage Configuration
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_DIR=/public/uploads
PRIVATE_UPLOAD_DIR=/private/uploads

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL is provided by docker-compose.production.yml on the internal
# availability-internal network. Use the Compose service name, not localhost.
# In production, Traefik is the sole ingress and must be the explicitly trusted
# proxy for X-Real-IP; forwardedHeaders.insecure must remain disabled.
POSTGRES_DB=your-postgres-database
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://your-postgres-user:replace-with-a-random-password@postgres:5432/your-postgres-database
# Keep production secrets outside git, protect .env.production (chmod 600),
# and use a unique high-entropy password in every environment.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Availability administration (use a bcrypt hash and a unique random secret)
AVAILABILITY_ADMIN_USERNAME=availability-admin
AVAILABILITY_ADMIN_PASSWORD_HASH=replace-with-bcrypt-password-hash
AVAILABILITY_SESSION_SECRET=replace-with-at-least-32-random-characters
AVAILABILITY_LOGIN_RATE_LIMIT_MAX=5
AVAILABILITY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AVAILABILITY_LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
AVAILABILITY_ICS_ENCRYPTION_KEY=replace-with-base64-32-byte-key
AVAILABILITY_ICS_FETCH_TIMEOUT_MS=10000
AVAILABILITY_ICS_MAX_RESPONSE_BYTES=2097152

# Redis Configuration (for rate limiting in production)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# =============================================================================
# Analytics and Monitoring
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Log Level
LOG_LEVEL=info

# =============================================================================
# External APIs
# =============================================================================
# Payment Gateway (Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN=your-mp-access-token
MERCADO_PAGO_PUBLIC_KEY=your-mp-public-key
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret

# Weather API
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# =============================================================================
# Content Delivery and Storage
# =============================================================================
# CDN Configuration
CDN_URL=https://cdn.goaventura.com.ar
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket

# =============================================================================
# Development Configuration
# =============================================================================
# Development Mode
NODE_ENV=development
DEV_MODE=true

# Debug and Logging
DEBUG=false
ENABLE_CORS_LOGGING=false
ENABLE_REQUEST_LOGGING=false

# Hot Reload (Development)
FAST_REFRESH=true

# =============================================================================
# Production Configuration
# =============================================================================
# Production Mode
# NODE_ENV=production
# DEV_MODE=false

# Security Headers (Production)
ENABLE_STRICT_TRANSPORT_SECURITY=true
ENABLE_CONTENT_SECURITY_POLICY=true
ENABLE_FRAME_PROTECTION=true

# =============================================================================
# Testing Configuration
# =============================================================================
# Testing Environment
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/goaventura_test
TEST_REDIS_URL=redis://localhost:6379/1

# Mock Services (for testing)
MOCK_EMAIL_SERVICE=true
MOCK_PAYMENT_GATEWAY=true

# =============================================================================
# Backup and Maintenance
# =============================================================================
# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=goaventura-backups

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Sitio en mantenimiento. Volvemos pronto."

# =============================================================================
# Feature Flags
# =============================================================================
# Feature Toggle Configuration
ENABLE_BLOG=true
ENABLE_ECOMMERCE=true
ENABLE_BOOKING_SYSTEM=true
ENABLE_USER_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_MULTI_LANGUAGE=true
ENABLE_DARK_MODE=true

# =============================================================================
# Social Media Configuration
# =============================================================================
# Social Media Links
FACEBOOK_URL=https://facebook.com/goaventura
INSTAGRAM_URL=https://instagram.com/goaventura
TWITTER_URL=https://twitter.com/goaventura
WHATSAPP_PHONE=5491168752436

# Social Login Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =============================================================================
# AI and Machine Learning
# =============================================================================
# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_PROJECT_ID=your-ai-project-id

# AI Model Configuration
AI_MODEL=gemini-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# =============================================================================
# Legal and Compliance
# =============================================================================
# Privacy and Legal
PRIVACY_POLICY_URL=/legal/privacidad
TERMS_OF_SERVICE_URL=/legal/terminos
COOKIE_POLICY_URL=/legal/cookies

# GDPR Compliance
GDPR_ENABLED=true
DATA_PROCESSING_OFFICER_EMAIL=dpo@goaventura.com.ar

# =============================================================================
# Performance and Optimization
# =============================================================================
# Caching Configuration
CACHE_TTL=3600
STATIC_CACHE_TTL=86400
API_CACHE_TTL=300

# Image Optimization
IMAGE_QUALITY=80
IMAGE_PLACEHOLDER=blur
IMAGE_FORMATS=webp,avif

# =============================================================================
# Monitoring and Alerts
# =============================================================================
# Uptime Monitoring
UPTIME_CHECK_INTERVAL=60
UPTIME_WEBHOOK_URL=https://hooks.slack.com/your-webhook

# Error Alerts
ERROR_NOTIFICATION_EMAIL=admin@goaventura.com.ar
ERROR_WEBHOOK_URL=https://hooks.slack.com/your-error-webhook

# =============================================================================
# WiFi Captive Portal Configuration
# =============================================================================
# JSON array of WiFi credentials for captive portal pages
# Format: [{"slug":"property-slug","propertyName":"Property Name","ssid":"NetworkSSID","password":"NetworkPassword"}]

# =============================================================================
# Local Development Overrides
# =============================================================================
# Override these values in .env.local for local development
# Do not modify the template file directly

# Example local overrides:
# NODE_ENV=development
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# MOCK_EMAIL_SERVICE=true
